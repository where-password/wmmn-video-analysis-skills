{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/collection.schema.json",
  "title": "Long Video Transcript Collection",
  "type": "object",
  "required": ["schema_version", "status", "collection_id", "title", "content_contract", "counts", "parameters", "episodes", "files", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "completed" },
    "collection_id": { "type": "string", "pattern": "^lc-[0-9a-f]{20}$" },
    "content_contract": {
      "type": "object",
      "required": ["catalog_is_navigation_only", "search_unit", "answer_grounding_required", "absence_is_not_proof"],
      "properties": {
        "catalog_is_navigation_only": { "const": true },
        "answer_grounding_required": { "const": true },
        "absence_is_not_proof": { "const": true }
      }
    },
    "counts": {
      "type": "object",
      "required": ["episodes", "duration_sec", "segments", "chunks", "sections", "characters"],
      "properties": {
        "episodes": { "type": "integer", "minimum": 1 },
        "segments": { "type": "integer", "minimum": 1 },
        "chunks": { "type": "integer", "minimum": 1 }
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ordinal", "key", "title", "transcript_file", "transcript_sha256", "duration_sec", "coverage", "counts", "sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^ep-[0-9]{4}$" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "transcript_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "additionalProperties": true
}
