{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/locate_result.schema.json",
  "title": "Long Video Locate Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "watermark",
    "query",
    "terms",
    "scope",
    "index_id",
    "transcript_sha256",
    "hit_count",
    "hits",
    "next_action",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "completed",
        "no_matches"
      ]
    },
    "watermark": {
      "type": "object",
      "required": [
        "author",
        "mark"
      ],
      "additionalProperties": true
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "start_sec",
        "end_sec",
        "timecode"
      ],
      "additionalProperties": true
    },
    "index_id": {
      "type": "string",
      "pattern": "^lv-[0-9a-f]{20}$"
    },
    "transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hit_count": {
      "type": "integer",
      "minimum": 0
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "start_sec",
          "end_sec",
          "timecode",
          "section",
          "score",
          "citations"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          },
          "timecode": {
            "type": "string"
          },
          "section": {
            "type": [
              "object",
              "null"
            ]
          },
          "score": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "evidence_id",
                "segment_id",
                "start_sec",
                "end_sec",
                "timecode",
                "quote",
                "quote_sha256"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string"
                },
                "segment_id": {
                  "type": "string"
                },
                "start_sec": {
                  "type": "number",
                  "minimum": 0
                },
                "end_sec": {
                  "type": "number",
                  "minimum": 0
                },
                "timecode": {
                  "type": "string"
                },
                "speaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "quote_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "next_action": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
