{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/mention_summary.schema.json",
  "title": "Entity Mention Index Summary",
  "type": "object",
  "required": ["schema_version", "status", "collection_id", "entities_sha256", "counts", "entities", "method", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "completed" },
    "collection_id": { "type": "string", "pattern": "^lc-[0-9a-f]{20}$" },
    "entities_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": {
      "type": "object",
      "required": ["entities", "mentions", "occurrences", "episodes_with_mentions"]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "aliases", "mention_records", "mention_count", "episode_count", "episode_ordinals"]
      }
    },
    "method": { "const": "exact casefolded alias matching; no automatic entity discovery" }
  },
  "additionalProperties": true
}
