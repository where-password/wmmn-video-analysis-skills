{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/evidence_manifest.schema.json",
  "title": "Time-coded Evidence Frame Manifest",
  "oneOf": [
    {
      "$ref": "#/$defs/completed"
    },
    {
      "$ref": "#/$defs/blocked"
    }
  ],
  "$defs": {
    "completed": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "watermark",
        "source",
        "contact_sheet",
        "shots",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "completed"
        },
        "watermark": {
          "type": "object",
          "required": [
            "author",
            "mark"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": true
        },
        "contact_sheet": {
          "type": "object",
          "required": [
            "path",
            "width",
            "height",
            "sha256"
          ]
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "start_sec",
              "end_sec",
              "frames"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "start_sec": {
                "type": "number",
                "minimum": 0
              },
              "end_sec": {
                "type": "number",
                "minimum": 0
              },
              "frames": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "role",
                    "time_sec",
                    "timecode",
                    "path",
                    "sha256",
                    "width",
                    "height",
                    "watermark"
                  ],
                  "properties": {
                    "role": {
                      "enum": [
                        "start",
                        "middle",
                        "end"
                      ]
                    },
                    "time_sec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "timecode": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "watermark": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "blocked": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "reason": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
