{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/media_mechanics.schema.json",
  "title": "Video Media Mechanics Measurement",
  "oneOf": [
    {
      "$ref": "#/$defs/completed"
    },
    {
      "$ref": "#/$defs/blocked"
    }
  ],
  "$defs": {
    "completed": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "watermark",
        "source",
        "method",
        "shots",
        "first_transition",
        "first_camera_movement",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "completed"
        },
        "watermark": {
          "type": "object",
          "required": [
            "author",
            "mark"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "provider",
            "source_hash",
            "duration_sec"
          ],
          "additionalProperties": true
        },
        "method": {
          "type": "object",
          "required": [
            "name",
            "sampling_fps",
            "frame_size_px",
            "claims"
          ],
          "additionalProperties": true
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "start_sec",
              "end_sec",
              "camera",
              "transition_in"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "start_sec": {
                "type": "number",
                "minimum": 0
              },
              "end_sec": {
                "type": "number",
                "minimum": 0
              },
              "camera": {
                "type": "object",
                "required": [
                  "type",
                  "label",
                  "confidence",
                  "evidence"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "evidence": {
                    "const": "measured_visual_motion"
                  }
                },
                "additionalProperties": true
              },
              "transition_in": {
                "type": "object",
                "required": [
                  "time_sec",
                  "type",
                  "label",
                  "confidence",
                  "evidence"
                ],
                "properties": {
                  "time_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "type": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "evidence": {
                    "enum": [
                      "measured_visual_transition",
                      "structural"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "first_transition": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "first_camera_movement": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "blocked": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "reason": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
