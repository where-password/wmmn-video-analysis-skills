{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/media_handle.schema.json",
  "title": "Host Media Handle",
  "type": "object",
  "required": [
    "media_path",
    "provider"
  ],
  "properties": {
    "media_path": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "host_media_handle",
        "browser_devtools",
        "public_url",
        "local_file"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_sec": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "has_audio": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}

